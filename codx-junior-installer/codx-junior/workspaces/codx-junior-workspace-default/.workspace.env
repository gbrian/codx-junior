# codx-junior domain (used by the workspace manager / Traefik routing)
CODX_JUNIOR_DOMAIN=gbrian.codxjunior.com

# KasmVNC credentials for kasm_user
VNC_PW=password

# Desktop resolution (auto-resized by the client unless disabled)
VNC_RESOLUTION=1920x1080

# VSCodium browser server (codium serve-web)
CODER_PORT=9080