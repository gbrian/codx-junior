      "content": "<script setup>\n</script>\n<template>\n<div class=\"flex flex-col gap-4 p-4 bg-base-100 rounded-box\">\n  <div class=\"form-control\">\n    <label class=\"label\">\n      <span class=\"label-text\">Model Name</span>\n    </label>\n    <input v-model=\"model.name\" type=\"text\" class=\"input input-bordered\" placeholder=\"Enter model name\" required />\n  </div>\n  \n  <div class=\"form-control\">\n    <label class=\"label\">\n      <span class=\"label-text\">API Key</span>\n    </label>\n    <input v-model=\"model.apiKey\" type=\"password\" class=\"input input-bordered\" placeholder=\"Enter API key\" required />\n  </div>\n  \n  <div class=\"form-control\">\n    <label class=\"label\">\n      <span class=\"label-text\">System Prompt</span>\n    </label>\n    <textarea v-model=\"model.systemPrompt\" class=\"textarea textarea-bordered\" placeholder=\"Enter system prompt\"></textarea>\n  </div>\n  \n  <div class=\"form-control\">\n    <label class=\"label\">\n      <span class=\"label-text\">Prompt Template</span>\n    </label>\n    <div class=\"flex flex-col\">\n      <textarea v-model=\"model.promptTemplate\" class=\"grow textarea textarea-bordered\" placeholder=\"Edit prompt template here\"></textarea>\n      <div class=\"text-xs text-gray-500 mt-2\">\n        Available variables:\n        <ul class=\"list-disc list-inside pl-4\">\n          <li><strong>MESSAGE</strong>: Mandatory. Represents the user's message or action.</li>\n          <li><strong>PROJECT_NAME</strong>: Optional. The name of the current project.</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n  \n  <div class=\"flex justify-end gap-2\">\n    <button @click=\"cancel\" class=\"btn btn-outline\">Cancel</button>\n    <button @click=\"save\" class=\"btn btn-primary\">Save Configuration</button>\n  </div>\n</div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      model: {\n        name: '',\n        apiKey: '',\n        systemPrompt: '',\n        promptTemplate: ''\n      }\n    }\n  },\n  methods: {\n    save() {\n      // Implementation for saving model configuration\n      this.$store.commit('saveModelConfig', this.model)\n      this.$emit('saved')\n    },\n    cancel() {\n      this.$emit('cancelled')\n    }\n  }\n}\n</script>",
