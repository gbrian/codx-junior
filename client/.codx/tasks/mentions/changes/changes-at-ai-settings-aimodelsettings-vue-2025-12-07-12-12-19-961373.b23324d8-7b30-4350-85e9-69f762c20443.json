  "description": "<script setup>\n</script>\n<template>\n  <div class=\"w-full\">\n    <div class=\"form-control w-full\">\n      <label class=\"label\">\n        <span class=\"label-text\">Model Type</span>\n      </label>\n      <select class=\"select select-bordered w-full\">\n        <option>gpt-3.5-turbo</option>\n        <option>gpt-4</option>\n      </select>\n    </div>\n    \n    <div class=\"form-control w-full mt-4\">\n      <label class=\"label\">\n        <span class=\"label-text\">API Key</span>\n      </label>\n      <input type=\"password\" class=\"input input-bordered w-full\" placeholder=\"Enter API key\" />\n    </div>\n    \n    <div class=\"form-control w-full mt-4\">\n      <label class=\"label\">\n        <span class=\"label-text\">Custom Endpoint</span>\n      </label>\n      <input type=\"text\" class=\"input input-bordered w-full\" placeholder=\"https://api.example.com\" />\n      <div class=\"text-sm mt-2 text-gray-500\">\n        <div>- MESSAGE: [Mandatory] Represents the user/action message</div>\n        <div>- PROJECT_NAME: [Optional] Represents the project name</div>\n      </div>\n    </div>\n    \n    <div class=\"mt-6 flex justify-end\">\n      <button class=\"btn btn-primary px-6\">Save Configuration</button>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  props: [],\n  data() {\n    return {\n      modelType: 'gpt-3.5-turbo',\n      apiKey: '',\n      customEndpoint: ''\n    }\n  },\n  computed: {\n    isConfigValid() {\n      return this.apiKey && this.customEndpoint.length > 10;\n    }\n  },\n  methods: {\n    async saveConfig() {\n      if (!this.isConfigValid) {\n        alert('Please enter valid API key and endpoint');\n        return;\n      }\n      // Save logic to $storex\n      this.$storex.commit('saveAPIConfig', {\n        modelType: this.modelType,\n        apiKey: this.apiKey,\n        endpoint: this.customEndpoint\n      });\n    }\n  }\n}\n</script>",
