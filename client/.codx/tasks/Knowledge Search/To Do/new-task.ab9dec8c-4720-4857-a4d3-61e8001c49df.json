      "content": "```vue src/views/KnowledgeView.vue\n<script setup>\nimport ProjectDetailt from '@/components/ProjectDetailt.vue'\nimport Code from '@/components/Code.vue'\n</script>\n<template>\n  <div class=\"flex flex-col gap-2 h-full px-4\">\n    <div class=\"font-medium flex flex-col gap-2\">\n      <div class=\"text-3xl flex gap-2 items-center\">\n        <ProjectDetailt v-model=\"project\" />\n        Knowledge\n      </div>\n      <!-- Search Form -->\n      <div class=\"flex gap-2 items-center\">\n        <input v-model=\"searchQuery\" type=\"text\" placeholder=\"Search...\"\n          @keydown.enter=\"search\"\n          class=\"input input-bordered w-full\" />\n        <i @click=\"search\" class=\"fas fa-search text-xl cursor-pointer\"></i>\n        <i @click=\"clearSearch\" class=\"fas fa-times text-xl cursor-pointer\"></i>\n      </div>\n    </div>\n\n    <!-- Loading indicator -->\n    <div v-if=\"loading\" class=\"flex items-center gap-2 py-4 text-base-content/70\">\n      <span class=\"loading loading-spinner loading-md\"></span>\n      <span class=\"text-sm font-medium\">Searching...</span>\n    </div>\n\n    <!-- Results count -->\n    <div v-if=\"searched && !loading\" class=\"text-sm text-base-content/60 font-medium\">\n      {{ resultList.length }} result{{ resultList.length !== 1 ? 's' : '' }} found\n    </div>\n\n    <!-- Results List -->\n    <div v-if=\"resultList.length\" class=\"flex flex-col gap-3 overflow-y-auto\">\n      <div\n        v-for=\"result in resultList\"\n        :key=\"result.id\"\n        class=\"card bg-base-200 shadow-sm\"\n      >\n        <div class=\"card-body p-4 gap-2\">\n          <!-- File source header -->\n          <div class=\"flex items-center justify-between gap-2\">\n            <div class=\"flex items-center gap-2 text-sm text-primary font-semibold truncate\">\n              <i class=\"fas fa-file-code\"></i>\n              <span class=\"truncate\" :title=\"result.metadata.source\">\n                {{ shortSource(result.metadata.source) }}\n              </span>\n            </div>\n            <!-- Score badge -->\n            <div class=\"badge badge-primary badge-lg font-bold shrink-0\">\n              <i class=\"fas fa-star text-xs mr-1\"></i>\n              {{ formatScore(result.metadata.score) }}\n            </div>\n          </div>\n\n          <!-- Metadata badges -->\n          <div class=\"flex flex-wrap gap-2 text-xs\">\n            <div class=\"badge badge-outline\">{{ result.metadata.language }}</div>\n            <div class=\"badge badge-outline\">{{ result.metadata.loader_type }}</div>\n            <div class=\"badge badge-outline\">\n              chunk {{ result.metadata.index + 1 }}/{{ result.metadata.total_docs }}\n            </div>\n            <div class=\"badge badge-outline\">{{ result.metadata.length }} chars</div>\n            <div class=\"badge badge-outline\">{{ result.metadata.index_date }}</div>\n          </div>\n\n          <!-- Page content rendered via Code -->\n          <div class=\"collapse collapse-arrow bg-base-300 rounded-box\">\n            <input type=\"checkbox\" />\n            <div class=\"collapse-title text-sm font-medium\">\n              Preview content\n            </div>\n            <div class=\"collapse-content overflow-auto max-h-64\">\n              <Code\n                :text=\"result.page_content\"\n                :text-language=\"result.metadata.language || 'text'\"\n                :file-name=\"result.metadata.source\"\n                :project=\"project\"\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Empty state -->\n    <div v-else-if=\"searched && !loading\" class=\"flex flex-col items-center gap-2 py-10 text-base-content/50\">\n      <i class=\"fas fa-search text-4xl\"></i>\n      <span class=\"text-lg\">No results found</span>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      searchQuery: '',\n      project: null,\n      results: [],\n      loading: false,\n      searched: false\n    }\n  },\n  computed: {\n    // Returns results sorted by score descending (highest first)\n    resultList() {\n      if (!this.results) return []\n      const list = Array.isArray(this.results) ? this.results : (this.results.data || [])\n      return [...list].sort((a, b) => {\n        const scoreA = a.metadata?.score ?? 0\n        const scoreB = b.metadata?.score ?? 0\n        return scoreB - scoreA\n      })\n    }\n  },\n  created() {\n    this.project = this.$project\n  },\n  methods: {\n    // Extract short filename from full path for display\n    shortSource(source) {\n      return source ? source.split('/').slice(-2).join('/') : source\n    },\n    // Format score to 2 decimal places\n    formatScore(score) {\n      return score != null ? Number(score).toFixed(2) : 'N/A'\n    },\n    async search() {\n      if (!this.searchQuery.trim()) return\n      this.loading = true\n      this.searched = false\n      this.results = []\n      try {\n        const res = await this.project.$api.knowledge.query(this.searchQuery.trim())\n        this.results = res || []\n      } catch (e) {\n        console.error('Knowledge search error:', e)\n        this.results = []\n      } finally {\n        this.loading = false\n        this.searched = true\n      }\n    },\n    clearSearch() {\n      this.searchQuery = ''\n      this.results = []\n      this.searched = false\n    }\n  }\n}\n</script>\n```",
