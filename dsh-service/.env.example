# ---------------------------------------------------------------------------
# Public hostname routed by Traefik.
#
# This must be the authority the browser dials, with no scheme, path, or :443
# suffix: it becomes both the Traefik Host() rule and DSH's --trusted-host.
# Create a DNS A/AAAA record for it pointing at this Docker host first.
# ---------------------------------------------------------------------------
DSH_DOMAIN=dsh.example.com

# npm version of @deepseek-ai/dsh installed into the image.
DSH_VERSION=0.2.1-rc.5

# UID/GID that own ./workspace and run the container. Use `id -u` / `id -g`
# for the host user who will edit files there.
DSH_UID=1000
DSH_GID=1000

# Host directory mounted as /workspace inside the container.
DSH_WORKSPACE=./workspace

# DeepSeek API key used by the web UI. You can also set it later under
# Settings -> Models; DSH stores that in the dsh-home volume.
DEEPSEEK_API_KEY=

# DSH's internal listener. Keep 3080 unless it collides on the shared network.
DSH_PORT=3080

# Existing external Docker network shared with Traefik. In this workspace the
# codx-junior Traefik instance uses "codx-junior_default".
TRAEFIK_NETWORK=codx-junior_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=sslresolver

TZ=UTC

# Optional: generated by scripts/set-basic-auth.sh and read only by
# compose.auth.yml. The bcrypt hash has its dollar signs doubled because
# Compose interpolates `$` in .env values.
# DSH_BASIC_AUTH_USERS=
