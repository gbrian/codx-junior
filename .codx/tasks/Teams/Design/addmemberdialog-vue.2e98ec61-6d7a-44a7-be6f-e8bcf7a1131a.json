      "content": "```html src/components/teams/AddMemberDialog.vue\n<script setup>\nimport MemberAvatar from './MemberAvatar.vue'\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-4 p-2 w-80\">\n    <h3 class=\"font-bold text-lg flex items-center gap-2\">\n      <i class=\"fa-solid fa-user-plus text-primary\"></i>\n      Add Member\n    </h3>\n\n    <div class=\"form-control gap-1\">\n      <label class=\"label label-text text-xs font-semibold\">Username *</label>\n      <input\n        v-model=\"form.username\"\n        type=\"text\"\n        class=\"input input-bordered input-sm\"\n        placeholder=\"Enter username\"\n        ref=\"usernameInput\"\n        @keydown.enter=\"submit\"\n      />\n    </div>\n\n    <div class=\"form-control gap-1\">\n      <label class=\"label label-text text-xs font-semibold\">Role</label>\n      <select class=\"select select-bordered select-sm\" v-model=\"form.role\">\n        <option value=\"admin\">\ud83d\udc51 Admin</option>\n        <option value=\"moderator\">\ud83d\udee1\ufe0f Moderator</option>\n        <option value=\"member\">\ud83d\udc64 Member</option>\n        <option value=\"guest\">\ud83d\udd0d Guest</option>\n      </select>\n    </div>\n\n    <!-- Preview -->\n    <div v-if=\"form.username\" class=\"flex items-center gap-3 p-3 bg-base-200 rounded-xl\">\n      <MemberAvatar :member=\"previewMember\" size=\"sm\" :show-status=\"false\" />\n      <div>\n        <div class=\"font-semibold text-sm\">{{ form.username }}</div>\n        <div class=\"text-xs text-base-content/50 capitalize\">{{ form.role }}</div>\n      </div>\n    </div>\n\n    <div class=\"flex gap-2 justify-end\">\n      <button class=\"btn btn-sm\" @click=\"$emit('close')\">Cancel</button>\n      <button\n        class=\"btn btn-sm btn-primary\"\n        :disabled=\"!form.username.trim()\"\n        @click=\"submit\"\n      >\n        <i class=\"fa-solid fa-user-plus\"></i>\n        Add Member\n      </button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'AddMemberDialog',\n  emits: ['added', 'close'],\n  props: {\n    team: { type: Object, required: true }\n  },\n  data() {\n    return {\n      form: {\n        username: '',\n        role: 'member'\n      }\n    }\n  },\n  mounted() {\n    this.$nextTick(() => this.$refs.usernameInput?.focus())\n  },\n  computed: {\n    previewMember() {\n      return { username: this.form.username, role: this.form.role, status: 'online' }\n    }\n  },\n  methods: {\n    submit() {\n      if (!this.form.username.trim()) return\n      const member = this.$storex.teams.addMember({\n        teamId: this.team.id,\n        memberData: {\n          username: this.form.username.trim(),\n          role: this.form.role,\n          status: 'offline'\n        }\n      })\n      this.$emit('added', member)\n    }\n  }\n}\n</script>\n```",
