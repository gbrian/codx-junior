            "content": "<script setup>\nimport Chat from '@/components/chat/Chat.vue'\nimport AppWindow from '@/components/windowManager/AppWindow.vue'\nimport ChatIcon from '@/components/chat/ChatIcon.vue'\nimport BranchSelector from '@/components/git/BranchSelector.vue'\n</script>\n\n<template>\n  <div class=\"flex flex-col h-full w-full bg-base-300 overflow-hidden\">\n    <!-- Status bar with git controls -->\n    <div class=\"flex items-center gap-2 px-3 py-1.5 bg-base-200 border-b border-base-content/10 text-xs shrink-0\">\n      <span class=\"flex items-center gap-1 text-success font-mono\">\n        <i class=\"fa-solid fa-circle text-[8px] animate-pulse\"></i>\n        vibe\n      </span>\n      <span class=\"text-base-content/40\">|</span>\n      <span class=\"font-mono text-base-content/60\">{{ $project?.project_name }}</span>\n      \n      <!-- Git section -->\n      <span class=\"text-base-content/40\">|</span>\n      <BranchSelector \n        :currentBranch=\"currentBranch\"\n        :branches=\"branches\"\n        @branch-selected=\"onBranchSelected\"\n        @create-branch=\"showCreateBranchModal = true\"\n      />\n\n      <div class=\"grow\"></div>\n\n      <!-- Layout toggles -->\n      <div class=\"join\">\n        <button \n          class=\"join-item btn btn-xs\" \n          :class=\"showChat ? 'btn-primary' : 'btn-ghost'\" \n          @click=\"showChat = !showChat\"\n          title=\"Toggle chat panel\">\n          <i class=\"fa-solid fa-comments\"></i>\n        </button>\n        <button \n          class=\"join-item btn btn-xs\" \n          :class=\"showPreview ? 'btn-success' : 'btn-ghost'\" \n          @click=\"showPreview = !showPreview\"\n          title=\"Toggle preview panel\">\n          <i class=\"fa-solid fa-display\"></i>\n        </button>\n      </div>\n\n      <button class=\"btn btn-xs btn-ghost\" @click=\"reloadWorkspace\" title=\"Refresh\">\n        <i class=\"fa-solid fa-rotate-right\"></i>\n      </button>\n    </div>\n\n    <!-- Main content -->\n    <div class=\"flex grow overflow-hidden min-h-0\">\n\n      <!-- LEFT: Chat panel -->\n      <div v-if=\"showChat\"\n        class=\"flex flex-col h-full border-r border-base-content/10 transition-all\"\n        :style=\"{ width: chatWidth }\">\n\n        <!-- Chat header -->\n        <div class=\"flex items-center gap-2 px-2 py-1.5 bg-base-200/60 shrink-0 border-b border-base-content/10\">\n          <ChatIcon mode=\"vibe\" class=\"text-sm\" />\n          <span class=\"text-sm font-bold truncate grow\">{{ vibeChat?.name || 'Vibe session' }}</span>\n          <button class=\"btn btn-xs btn-ghost\" @click=\"newVibeChat\" title=\"New session\">\n            <i class=\"fa-solid fa-plus\"></i>\n          </button>\n          <button class=\"btn btn-xs btn-ghost\" @click=\"showChatPicker = !showChatPicker\" title=\"Switch session\">\n            <i class=\"fa-solid fa-chevron-down\"></i>\n          </button>\n        </div>\n\n        <!-- Chat session picker dropdown -->\n        <div v-if=\"showChatPicker\" class=\"bg-base-100 border-b border-base-content/10 max-h-40 overflow-y-auto z-10\">\n          <div v-for=\"c in vibeSessions\" :key=\"c.id\"\n            class=\"flex items-center gap-2 px-2 py-1.5 text-xs cursor-pointer hover:bg-base-200\"\n            :class=\"vibeChat?.id === c.id ? 'bg-primary/10 text-primary' : ''\"\n            @click=\"selectSession(c)\">\n            <ChatIcon :mode=\"c.mode\" class=\"opacity-60\" />\n            <span class=\"truncate grow\">{{ c.name }}</span>\n            <span class=\"text-base-content/30 shrink-0\">{{ formatDate(c.updated_at) }}</span>\n          </div>\n          <div v-if=\"!vibeSessions.length\" class=\"px-2 py-2 text-xs text-base-content/40 text-center\">\n            No vibe sessions yet\n          </div>\n        </div>\n\n        <!-- Chat component with PR review mode support -->\n        <div class=\"grow min-h-0 overflow-hidden\" v-if=\"vibeChat\">\n          <Chat :chat=\"vibeChat\" class=\"h-full\" @refresh-chat=\"reloadVibeChat\" />\n          \n          <!-- Quick PR review mode toggle in chat footer -->\n          <div v-if=\"vibeChat\" class=\"border-t border-base-content/10 bg-base-200/30 px-2 py-1.5 text-xs flex items-center gap-2\">\n            <label class=\"flex items-center gap-2 cursor-pointer\">\n              <input \n                type=\"checkbox\" \n                class=\"checkbox checkbox-xs\"\n                v-model=\"prReviewMode\"\n                @change=\"onTogglePRReview\"\n              />\n              <span>PR Review Mode</span>\n            </label>\n            <span v-if=\"prReviewMode\" class=\"text-warning text-[10px] ml-auto\">\n              <i class=\"fa-solid fa-code-compare\"></i> Changes view enabled\n            </span>\n          </div>\n        </div>\n        <div v-else class=\"grow flex flex-col items-center justify-center gap-3 p-4 text-base-content/40\">\n          <i class=\"fa-solid fa-wand-magic-sparkles text-4xl\"></i>\n          <span class=\"text-sm\">Start a vibe coding session</span>\n          <button class=\"btn btn-sm btn-primary\" @click=\"newVibeChat\">\n            <i class=\"fa-solid fa-plus\"></i> New session\n          </button>\n        </div>\n      </div>\n\n      <!-- RIGHT: Preview / VNC workspace -->\n      <div v-if=\"showPreview\"\n        class=\"flex flex-col h-full grow min-w-0 overflow-hidden\">\n\n        <div class=\"flex items-center gap-2 px-2 py-1.5 bg-base-200/60 border-b border-base-content/10 shrink-0\">\n          <i class=\"fa-solid fa-display text-success text-sm\"></i>\n          <span class=\"text-sm font-bold grow\">Preview</span>\n\n          <!-- App selector -->\n          <select class=\"select select-xs select-bordered max-w-[180px]\"\n            v-model=\"selectedAppKey\"\n            @change=\"onAppSelected\">\n            <option value=\"\">-- Select workspace app --</option>\n            <option v-for=\"app in projectApps\" :key=\"app.key\" :value=\"app.key\">\n              {{ app.workspaceName }} / {{ app.name }}\n            </option>\n          </select>\n\n          <button class=\"btn btn-xs btn-ghost\" @click=\"reloadPreview\" title=\"Reload preview\">\n            <i class=\"fa-solid fa-rotate-right\"></i>\n          </button>\n          <button class=\"btn btn-xs btn-ghost\" @click=\"openPreviewFullscreen\" title=\"Fullscreen\" v-if=\"selectedApp\">\n            <i class=\"fa-solid fa-expand\"></i>\n          </button>\n        </div>\n\n        <!-- AppWindow rendered here -->\n        <div class=\"grow min-h-0 relative overflow-hidden bg-base-100\" v-if=\"selectedApp\" :key=\"previewKey\">\n          <AppWindow\n            :workspace=\"selectedApp.workspace\"\n            :app=\"selectedApp.app\"\n            class=\"w-full h-full\"\n          />\n        </div>\n\n        <!-- Empty state -->\n        <div v-else class=\"grow flex flex-col items-center justify-center gap-3 text-base-content/30\">\n          <i class=\"fa-solid fa-display text-5xl\"></i>\n          <span class=\"text-sm\">Select a workspace app to preview</span>\n          <div class=\"text-xs max-w-xs text-center leading-relaxed\" v-if=\"!projectApps?.length\">\n            No workspace apps configured for this project. Add a VNC app in workspace settings.\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Create branch modal -->\n    <modal v-if=\"showCreateBranchModal\">\n      <div class=\"flex flex-col gap-4 p-4 min-w-96\">\n        <h3 class=\"font-bold text-lg\">Create New Branch</h3>\n        <div class=\"form-control\">\n          <label class=\"label\"><span class=\"label-text\">From branch</span></label>\n          <select class=\"select select-bordered select-sm\" v-model=\"createBranchFrom\">\n            <option v-for=\"b in branches\" :key=\"b\" :value=\"b\">{{ b }}</option>\n          </select>\n        </div>\n        <input \n          v-model=\"newBranchName\" \n          type=\"text\" \n          class=\"input input-bordered input-sm\" \n          placeholder=\"Branch name (e.g., feature/my-feature)\"\n          @keydown.enter=\"onCreateBranch\"\n        />\n        <div class=\"flex gap-2 justify-end\">\n          <button class=\"btn btn-sm\" @click=\"showCreateBranchModal = false\">Cancel</button>\n          <button \n            class=\"btn btn-sm btn-primary\" \n            @click=\"onCreateBranch\"\n            :disabled=\"!newBranchName.trim()\">\n            Create\n          </button>\n        </div>\n      </div>\n    </modal>\n  </div>\n</template>\n\n<script>\nimport moment from 'moment'\nimport { v4 as uuidv4 } from 'uuid'\n\nexport default {\n  props: ['chatMode', 'chat', 'kanban', 'params'],\n  data() {\n    return {\n      showChat: true,\n      showPreview: true,\n      showChatPicker: false,\n      vibeChat: null,\n      selectedAppKey: '',\n      selectedApp: null,\n      previewKey: 0,\n      branches: [],\n      currentBranch: 'main',\n      prReviewMode: false,\n      showCreateBranchModal: false,\n      createBranchFrom: 'main',\n      newBranchName: ''\n    }\n  },\n  created() {\n    this.init()\n  },\n  computed: {\n    projectApps() {\n      return this.$projects.projectApps || []\n    },\n    vibeSessions() {\n      return this.$chats.allChats\n        .filter(c => c.mode === 'vibe')\n        .sort((a, b) => (a.updated_at > b.updated_at ? -1 : 1))\n    },\n    chatWidth() {\n      return this.showPreview ? '50%' : '100%'\n    }\n  },\n  watch: {\n    '$projects.activeProject'() {\n      this.init()\n    },\n    vibeSessions(sessions) {\n      if (!this.vibeChat && sessions.length) {\n        this.vibeChat = sessions[0]\n      }\n    }\n  },\n  methods: {\n    async init() {\n      await this.$projects.loadBranches()\n      this.branches = this.$projects.branches || ['main']\n      this.currentBranch = this.$projects.currentBranch || 'main'\n      this.vibeChat = this.vibeSessions[0] || null\n      this.autoSelectApp()\n    },\n\n    autoSelectApp() {\n      const vncApp = this.projectApps.find(a =>\n        a.name?.toLowerCase().includes('vnc') ||\n        a.type?.toLowerCase().includes('vnc')\n      ) || this.projectApps[0]\n      if (vncApp) {\n        this.selectedAppKey = vncApp.key\n        this.onAppSelected()\n      }\n    },\n\n    onAppSelected() {\n      const app = this.projectApps.find(a => a.key === this.selectedAppKey)\n      if (!app) { this.selectedApp = null; return }\n      const workspaces = this.$storex.projects.workspaces || []\n      const workspace = workspaces.find(w => w.name === app.workspaceName)\n      this.selectedApp = workspace ? { workspace, app } : null\n      this.previewKey++\n    },\n\n    async onBranchSelected(branch) {\n      this.currentBranch = branch\n      await this.$projects.switchBranch(branch)\n      this.reloadWorkspace()\n    },\n\n    async onCreateBranch() {\n      if (!this.newBranchName.trim()) return\n      try {\n        await this.$projects.createBranch({\n          name: this.newBranchName,\n          from: this.createBranchFrom\n        })\n        await this.$projects.loadBranches()\n        this.branches = this.$projects.branches || []\n        this.currentBranch = this.newBranchName\n        this.showCreateBranchModal = false\n        this.newBranchName = ''\n        this.$storex.ui.addNotification({ text: `Branch ${this.newBranchName} created`, type: 'success' })\n      } catch (error) {\n        this.$storex.ui.addNotification({ text: `Error creating branch: ${error.message}`, type: 'error' })\n      }\n    },\n\n    onTogglePRReview() {\n      if (this.prReviewMode && this.vibeChat) {\n        this.vibeChat.mode = 'prview'\n        this.$chats.saveChat(this.vibeChat)\n      }\n    },\n\n    async newVibeChat() {\n      this.showChatPicker = false\n      const chat = await this.$chats.createNewChat({\n        id: uuidv4(),\n        name: `Vibe ${moment().format('MMM D HH:mm')}`,\n        mode: 'vibe',\n        board: 'codx-junior',\n        project_id: this.$project.project_id,\n        messages: []\n      })\n      await this.$chats.saveChat(chat)\n      this.vibeChat = chat\n    },\n\n    selectSession(chat) {\n      this.vibeChat = chat\n      this.showChatPicker = false\n      this.prReviewMode = chat.mode === 'prview'\n    },\n\n    reloadVibeChat() {\n      if (this.vibeChat) this.$chats.reloadChat(this.vibeChat)\n    },\n\n    reloadPreview() {\n      this.previewKey++\n    },\n\n    openPreviewFullscreen() {\n      if (this.selectedApp) {\n        this.$projects.openWorkspaceApp(this.selectedApp)\n      }\n    },\n\n    reloadWorkspace() {\n      this.reloadPreview()\n      if (this.vibeChat) this.reloadVibeChat()\n    },\n\n    formatDate(date) {\n      return moment(date).fromNow()\n    }\n  }\n}\n</script>"
          },
          {
            "language": "vue",
            "file_path": "client/src/components/git/BranchSelector.vue",
            "content": "<script setup>\n</script>\n\n<template>\n  <div class=\"flex items-center gap-1\">\n    <!-- Current branch display -->\n    <div class=\"dropdown dropdown-hover\">\n      <div tabindex=\"0\" class=\"flex items-center gap-1 cursor-pointer hover:text-primary transition-colors\">\n        <i class=\"fa-solid fa-code-branch text-info\"></i>\n        <span class=\"font-mono text-sm font-semibold\">{{ currentBranch }}</span>\n        <i class=\"fa-solid fa-chevron-down text-xs opacity-60\"></i>\n      </div>\n      \n      <!-- Branch dropdown menu -->\n      <ul tabindex=\"0\" class=\"dropdown-content menu bg-base-100 rounded-box z-[1] w-48 p-1 shadow border border-base-content/10 max-h-60 overflow-y-auto\">\n        <li v-for=\"branch in branches\" :key=\"branch\">\n          <a \n            :class=\"currentBranch === branch ? 'active bg-primary/20 text-primary' : ''\"\n            @click=\"$emit('branch-selected', branch)\">\n            <span class=\"text-xs font-mono\">{{ branch }}</span>\n            <span v-if=\"currentBranch === branch\" class=\"badge badge-xs badge-primary ml-auto\">\n              <i class=\"fa-solid fa-check\"></i>\n            </span>\n          </a>\n        </li>\n        <li class=\"divider my-1\" v-if=\"branches.length\"></li>\n        <li>\n          <a @click=\"$emit('create-branch')\" class=\"text-primary\">\n            <i class=\"fa-solid fa-plus text-xs\"></i>\n            <span class=\"text-xs\">New branch</span>\n          </a>\n        </li>\n      </ul>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  props: {\n    currentBranch: {\n      type: String,\n      default: 'main'\n    },\n    branches: {\n      type: Array,\n      default: () => ['main']\n    }\n  }\n}\n</script>"
