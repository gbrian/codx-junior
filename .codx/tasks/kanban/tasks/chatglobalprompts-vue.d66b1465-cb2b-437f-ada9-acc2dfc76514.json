\"\n            />\n          </div>\n\n          <label class=\"label\">\n            <span class=\"label-text-alt text-base-content/60\">\n              Tip: Use variables like {user}, {context}, {date} for dynamic content\n            </span>\n          </label>\n        </div>\n\n        <!-- Preview Section -->\n        <div class=\"divider my-2\"></div>\n        <details class=\"collapse border border-base-300 bg-base-200\">\n          <summary class=\"collapse-title font-semibold flex items-center gap-2\">\n            <i class=\"fa-solid fa-eye\"></i>\n            Preview\n          </summary>\n          <div class=\"collapse-content\">\n            <div class=\"bg-base-100 p-4 rounded-lg border border-base-300 font-mono text-sm whitespace-pre-wrap break-words\">\n              {{ promptContent || 'No prompt configured' }}\n            </div>\n          </div>\n        </details>\n      </div>\n    </div>\n\n    <!-- Reset to Default Button -->\n    <div class=\"flex gap-2\">\n      <button\n        @click=\"resetToDefault\"\n        class=\"btn btn-outline btn-sm gap-2\"\n      >\n        <i class=\"fa-solid fa-rotate-left\"></i>\n        Reset to Default\n      </button>\n      <div class=\"flex-1\"></div>\n      <span class=\"text-xs text-base-content/50 self-center\">\n        Changes are saved automatically\n      </span>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  props: {\n    settings: {\n      type: Object,\n      required: true\n    }\n  },\n  data() {\n    return {\n      maxCharacters: 5000,\n      defaultPrompt: 'You are a helpful assistant. Provide clear and concise responses.',\n      promptContent: ''\n    }\n  },\n  computed: {\n    characterCount() {\n      return this.promptContent?.length || 0\n    }\n  },\n  watch: {\n    'settings.chat_global_instructions': {\n      handler(newVal) {\n        this.promptContent = newVal || ''\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    onCodeChange({ newContent }) {\n      this.promptContent = newContent\n      this.settings.chat_global_instructions = newContent\n      this.$emit('update:settings', this.settings)\n    },\n    resetToDefault() {\n      this.promptContent = this.defaultPrompt\n      this.settings.chat_global_instructions = this.defaultPrompt\n      this.$emit('update:settings', this.settings)\n      this.$ui.addNotification({ text: 'Reset to default prompt' })\n    }\n  }\n}\n</script>\n```\n\n**Key Changes:**\n\n1. **Added CodeViewer Import**: Imported the `CodeViewer` component in the setup section\n2. **Replaced Textarea with CodeViewer**: The textarea is now replaced with a `CodeViewer` component\n3. **V-model Support**: Added `promptContent` data property to sync with CodeViewer\n4. **Message Change Handler**: The `onCodeChange` method handles code updates from CodeViewer\n5. **Automatic Save**: Changes are automatically emitted to update parent settings (no manual save button since v-model mode disables save options)\n6. **Watcher**: Added a watcher to sync external setting changes with the component's promptContent\n7. **Preview Update**: Preview section now uses `promptContent` instead of settings directly\n8. **Character Counter**: Now tracks `promptContent` length\n9. **Styled Container**: Added border and height styling for better integration\n\nThe CodeViewer will automatically hide the \"Save\" button when used with v-model, and all changes are reflected in real-time to the parent component.",
