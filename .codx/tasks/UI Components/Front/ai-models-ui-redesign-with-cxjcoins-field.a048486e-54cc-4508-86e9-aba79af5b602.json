\">\n            <i class=\"fa-solid fa-circle-nodes\"></i> Classification\n          </div>\n          <div class=\"grid grid-cols-2 gap-3\">\n            <div class=\"form-control\">\n              <label class=\"label py-1\">\n                <span class=\"label-text text-xs\">Model Type</span>\n              </label>\n              <select class=\"select select-bordered select-sm\" v-model=\"model.model_type\">\n                <option value=\"llm\">LLM</option>\n                <option value=\"embeddings\">Embeddings</option>\n              </select>\n            </div>\n            <div class=\"form-control\">\n              <label class=\"label py-1\">\n                <span class=\"label-text text-xs\">AI Provider</span>\n              </label>\n              <select class=\"select select-bordered select-sm\" v-model=\"model.ai_provider\">\n                <option v-for=\"provider in aiProviders\" :key=\"provider.name\" :value=\"provider.name\">\n                  {{ provider.name }}\n                </option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <!-- Identity -->\n        <div class=\"flex flex-col gap-3 p-3 bg-base-200 rounded-lg\">\n          <div class=\"text-xs font-bold uppercase tracking-widest text-secondary flex items-center gap-1\">\n            <i class=\"fa-solid fa-tag\"></i> Identity\n          </div>\n          <div class=\"form-control\">\n            <label class=\"label py-1\">\n              <span class=\"label-text text-xs\">Model Name</span>\n            </label>\n            <input class=\"input input-bordered input-sm\" v-model=\"model.name\" placeholder=\"Model Name\" />\n          </div>\n          <div class=\"form-control\">\n            <label class=\"label py-1\">\n              <span class=\"label-text text-xs\">AI Provider Model's Name</span>\n            </label>\n            <input class=\"input input-bordered input-sm font-mono text-xs\" v-model=\"model.ai_model\" :placeholder=\"model.name\" />\n          </div>\n          <div class=\"form-control\">\n            <label class=\"label py-1\">\n              <span class=\"label-text text-xs\"><i class=\"fa-solid fa-network-wired mr-1 text-info\"></i>Model URL</span>\n            </label>\n            <input class=\"input input-bordered input-sm font-mono text-xs\" v-model=\"model.url\" placeholder=\"https://...\" />\n          </div>\n        </div>\n\n        <!-- Billing -->\n        <div class=\"flex flex-col gap-3 p-3 bg-base-200 rounded-lg\">\n          <div class=\"text-xs font-bold uppercase tracking-widest text-warning flex items-center gap-1\">\n            <i class=\"fa-solid fa-coins\"></i> Billing\n          </div>\n          <div class=\"form-control\">\n            <label class=\"label py-1\">\n              <span class=\"label-text text-xs\"><i class=\"fa-solid fa-coins mr-1 text-yellow-500\"></i>Cost / 1K tokens</span>\n            </label>\n            <div class=\"flex items-center gap-1\">\n              <input class=\"input input-bordered input-sm w-full\" type=\"number\" step=\"0.0001\" v-model.number=\"model.k_tokens_cxjcoins\" placeholder=\"0.0000\" />\n              <span class=\"text-xs text-base-content/50 shrink-0\">cxj</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- LLM Parameters -->\n        <div class=\"flex flex-col gap-3 p-3 bg-base-200 rounded-lg\" v-if=\"currentModelIsLLM\">\n          <div class=\"text-xs font-bold uppercase tracking-widest text-info flex items-center gap-1\">\n            <i class=\"fa-solid fa-sliders\"></i> LLM Parameters\n          </div>\n          <div class=\"grid grid-cols-2 gap-3\">\n            <div class=\"form-control\">\n              <label class=\"label py-1\">\n                <span class=\"label-text text-xs\">Temperature</span>\n              </label>\n              <input type=\"number\" class=\"input input-bordered input-sm\" v-model.number=\"model.settings.temperature\" placeholder=\"1.0\" step=\"0.1\" />\n            </div>\n            <div class=\"form-control\">\n              <label class=\"label py-1\">\n                <span class=\"label-text text-xs\">Context length (KB)</span>\n              </label>\n              <input type=\"number\" class=\"input input-bordered input-sm\" v-model.number=\"model.settings.context_length\" placeholder=\"Context length\" step=\"1\" />\n            </div>\n          </div>\n          <div class=\"form-control\">\n            <label class=\"label py-1 cursor-pointer justify-start gap-3\">\n              <input type=\"checkbox\" class=\"toggle toggle-sm toggle-primary\" v-model=\"model.settings.merge_messages\" />\n              <span class=\"label-text text-xs\">Merge messages</span>\n            </label>\n          </div>\n        </div>\n\n        <!-- Embeddings Parameters -->\n        <div class=\"flex flex-col gap-3 p-3 bg-base-200 rounded-lg\" v-if=\"!currentModelIsLLM\">\n          <div class=\"text-xs font-bold uppercase tracking-widest text-info flex items-center gap-1\">\n            <i class=\"fa-solid fa-sliders\"></i> Embeddings Parameters\n          </div>\n          <div class=\"grid grid-cols-2 gap-3\">\n            <div class=\"form-control\">\n              <label class=\"label py-1\">\n                <span class=\"label-text text-xs\">Vector Size</span>\n              </label>\n              <input type=\"number\" class=\"input input-bordered input-sm\" v-model.number=\"model.settings.vector_size\" placeholder=\"1536\" />\n            </div>\n            <div class=\"form-control\">\n              <label class=\"label py-1\">\n                <span class=\"label-text text-xs\">Chunk Size</span>\n              </label>\n              <input type=\"number\" class=\"input input-bordered input-sm\" v-model.number=\"model.settings.chunk_size\" placeholder=\"8190\" />\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Right column: prompt template -->\n      <div class=\"flex flex-col gap-3 w-1/2\">\n        <div class=\"flex flex-col gap-3 p-3 bg-base-200 rounded-lg h-full\">\n          <div class=\"text-xs font-bold uppercase tracking-widest text-accent flex items-center gap-1\">\n            <i class=\"fa-solid fa-scroll\"></i> Prompt Configuration\n          </div>\n          <div class=\"form-control\">\n            <label class=\"label py-1\">\n              <span class=\"label-text text-xs\">System Instructions</span>\n            </label>\n            <textarea class=\"textarea textarea-bordered text-xs h-24\" v-model=\"model.system\" placeholder=\"System instructions...\"></textarea>\n          </div>\n          <div class=\"form-control grow flex flex-col\">\n            <label class=\"label py-1\">\n              <span class=\"label-text text-xs\">Prompt Template</span>\n            </label>\n            <textarea class=\"textarea textarea-bordered text-xs grow\" v-model=\"model.prompt_template\" placeholder=\"Edit prompt template...\"></textarea>\n          </div>\n          <div class=\"text-xs text-base-content/50 p-2 bg-base-300 rounded-lg\">\n            <div class=\"font-semibold mb-1\">Available variables:</div>\n            <ul class=\"list-disc list-inside pl-2 space-y-1\">\n              <li><strong class=\"text-primary\">MESSAGE</strong> \u2014 Mandatory. The user's message or action.</li>\n              <li><strong class=\"text-secondary\">PROJECT_NAME</strong> \u2014 Optional. Current project name.</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Test chat tab -->\n    <Chat class=\"w-full min-h-full grow\" :chat=\"testChat\" v-if=\"tabIx === 1 && testChat\" />\n\n    <!-- Actions -->\n    <div class=\"flex justify-between items-center pt-1\">\n      <button class=\"btn btn-ghost btn-sm text-error\" @click=\"$emit('delete', model)\">\n        <i class=\"fa-solid fa-trash-can mr-1\"></i> Delete\n      </button>\n      <div class=\"flex gap-2\">\n        <button class=\"btn btn-primary btn-sm\" @click=\"$emit('save', model)\">\n          <i class=\"fa-solid fa-floppy-disk mr-1\"></i> Save\n        </button>\n        <button class=\"btn btn-ghost btn-sm\" @click=\"$emit('cancel')\">\n          Cancel\n        </button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  props: ['model', 'aiProviders'],\n  data() {\n    return {\n      tabIx: 0,\n      testChat: null\n    }\n  },\n  computed: {\n    currentModelIsLLM() {\n      return this.model?.model_type === 'llm'\n    }\n  },\n  methods: {\n    async newChat() {\n      if (!this.testChat) {\n        this.testChat = await this.$chats.createNewChat({ test: true })\n      }\n      this.tabIx = 1\n    }\n  }\n}\n</script>\n```\n\n```vue client/src/components/ai_settings/AIModels.vue\n<script setup>\nimport AIModelSettings from './AIModelSettings.vue'\n</script>\n\n<template>\n  <div class=\"w-full h-full flex flex-col gap-4 p-4\">\n    <!-- Page header -->\n    <div class=\"flex items-center gap-3 bg-gradient-to-r from-primary/20 to-transparent rounded-xl px-4 py-3\">\n      <div class=\"avatar placeholder\">\n        <div class=\"bg-primary text-primary-content rounded-full w-10 h-10 flex items-center justify-center\">\n          <i class=\"fa-solid fa-brain text-lg\"></i>\n        </div>\n      </div>\n      <div>\n        <div class=\"font-bold text-xl\">AI Models</div>\n        <div class=\"text-xs text-base-content/50\">{{ aiModels.length }} model(s) configured</div>\n      </div>\n    </div>\n\n    <!-- Models grid -->\n    <div class=\"grid grid-cols-1 @md:grid-cols-2 @xl:grid-cols-3 gap-4\">\n      <div\n        v-for=\"model in aiModels\"\n        :key=\"model.name\"\n        class=\"card border border-base-300 bg-base-200 p-4 shadow-sm flex flex-col justify-between cursor-pointer hover:border-primary/50 transition-colors\"\n        @click=\"editModel(model)\"\n      >\n        <!-- Card header -->\n        <div class=\"flex items-start gap-2 mb-3\">\n          <div class=\"avatar placeholder\">\n            <div :class=\"model.model_type === 'llm' ? 'bg-warning/20 text-warning' : 'bg-info/20 text-info'\" \n                 class=\"rounded-full w-8 h-8 flex items-center justify-center text-sm\">\n              <i :class=\"model.model_type === 'llm' ? 'fa-solid fa-brain' : 'fa-solid fa-file'\"></i>\n            </div>\n          </div>\n          <div class=\"grow overflow-hidden\">\n            <div class=\"font-bold text-primary truncate\">{{ model.name }}</div>\n            <div class=\"text-xs text-base-content/50 truncate\" v-if=\"model.ai_model && model.name !== model.ai_model\">\n              {{ model.ai_model }}\n            </div>\n          </div>\n          <div class=\"flex flex-col items-end gap-1 shrink-0\">\n            <span :class=\"model.model_type === 'llm' ? 'badge-warning' : 'badge-info'\" class=\"badge badge-xs\">\n              {{ model.model_type === 'llm' ? 'LLM' : 'Embeddings' }}\n            </span>\n          </div>\n        </div>\n\n        <!-- Card stats -->\n        <div class=\"flex flex-col gap-1 text-xs text-base-content/70 mb-3\">\n          <div class=\"flex items-center gap-1\">\n            <i class=\"fa-solid fa-plug w-3 text-secondary\"></i>\n            <span class=\"font-medium\">{{ model.ai_provider || '-' }}</span>\n          </div>\n          <template v-if=\"model.model_type === 'llm'\">\n            <div class=\"flex items-center gap-1\">\n              <i class=\"fa-solid fa-thermometer-half w-3 text-orange-400\"></i>\n              <span>Temp: {{ model.settings?.temperature ?? '-' }}</span>\n            </div>\n            <div class=\"flex items-center gap-1\" v-if=\"model.settings?.context_length\">\n              <i class=\"fa-solid fa-memory w-3 text-blue-400\"></i>\n              <span>Context: {{ model.settings.context_length }} KB</span>\n            </div>\n            <div class=\"flex items-center gap-1\" v-if=\"model.settings?.merge_messages\">\n              <i class=\"fa-solid fa-compress w-3 text-purple-400\"></i>\n              <span>Merge messages: on</span>\n            </div>\n          </template>\n          <template v-else>\n            <div class=\"flex items-center gap-1\">\n              <i class=\"fa-solid fa-vector-square w-3 text-teal-400\"></i>\n              <span>Vector: {{ model.settings?.vector_size || '-' }}</span>\n            </div>\n            <div class=\"flex items-center gap-1\">\n              <i class=\"fa-solid fa-scissors w-3 text-pink-400\"></i>\n              <span>Chunk: {{ model.settings?.chunk_size || '-' }}</span>\n            </div>\n          </template>\n          <!-- Cost badge -->\n          <div class=\"flex items-center gap-1\" v-if=\"model.k_tokens_cxjcoins\">\n            <i class=\"fa-solid fa-coins w-3 text-yellow-400\"></i>\n            <span>{{ model.k_tokens_cxjcoins }} cxj / 1K tokens</span>\n          </div>\n        </div>\n\n        <!-- Card actions -->\n        <div class=\"flex gap-2 mt-auto pt-2 border-t border-base-300\">\n          <button class=\"btn btn-xs btn-circle btn-outline text-info\" @click.stop=\"showModelInfo = model\">\n            <i class=\"fa-solid fa-circle-info\"></i>\n          </button>\n          <button class=\"btn btn-xs btn-circle btn-outline\" @click.stop=\"editModel(model)\">\n            <i class=\"fa-solid fa-pen-to-square\"></i>\n          </button>\n          <div class=\"grow\"></div>\n          <button\n            class=\"btn btn-xs btn-circle btn-info btn-outline tooltip\"\n            :class=\"model.loading && 'animate-pulse btn-warning'\"\n            data-tip=\"Reload model (depends on provider)\"\n            @click.stop=\"reloadModel(model)\"\n          >\n            <i class=\"fa-solid fa-arrows-rotate\"></i>\n          </button>\n        </div>\n      </div>\n\n      <!-- Add new card -->\n      <div\n        class=\"card border-2 border-dashed border-base-300 p-4 flex justify-center items-center cursor-pointer hover:border-primary/50 transition-colors min-h-32\"\n        @click=\"editModel(null)\"\n      >\n        <div class=\"flex flex-col items-center gap-2 text-base-content/40\">\n          <i class=\"fa-solid fa-plus-circle text-2xl\"></i>\n          <span class=\"text-sm\">Add New Model</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Edit modal -->\n    <modal class=\"w-2/3 h-5/6 overflow-auto\" v-if=\"showDialog\">\n      <AIModelSettings\n        :aiProviders=\"aiProviders\"\n        :model=\"currentModel\"\n        @save=\"saveModel\"\n        @cancel=\"showDialog = false\"\n        @delete=\"confirmDelete\"\n      />\n    </modal>\n\n    <!-- Info modal -->\n    <modal class=\"w-1/3 h-2/3\" close=\"true\" @close=\"showModelInfo = null\" v-if=\"showModelInfo\">\n      <div class=\"flex items-center gap-2 mb-3\">\n        <i class=\"fa-solid fa-circle-info text-info\"></i>\n        <div class=\"text-xl font-bold\">{{ showModelInfo.name }}</div>\n      </div>\n      <pre class=\"overflow-auto text-xs bg-base-300 p-3 rounded-lg\">{{ showModelInfo.metadata?.info }}</pre>\n    </modal>\n\n    <!-- Delete confirm modal -->\n    <modal v-if=\"showDeleteDialog\">\n      <div class=\"flex flex-col gap-4\">\n        <div class=\"flex items-center gap-2 text-error\">\n          <i class=\"fa-solid fa-triangle-exclamation text-xl\"></i>\n          <span class=\"font-bold text-lg\">Confirm Delete</span>\n        </div>\n        <p class=\"text-sm\">Are you sure you want to delete <strong>{{ modelToDelete?.name }}</strong>? This action cannot be undone.</p>\n        <div class=\"flex justify-end gap-2\">\n          <button class=\"btn btn-ghost btn-sm\" @click=\"showDeleteDialog = false\">Cancel</button>\n          <button class=\"btn btn-error btn-sm\" @click=\"deleteModel\">\n            <i class=\"fa-solid fa-trash-can mr-1\"></i> Delete\n          </button>\n        </div>\n      </div>\n    </modal>\n  </div>\n</template>\n\n<script>\nexport default {\n  props: ['settings'],\n  data() {\n    return {\n      showDialog: false,\n      showDeleteDialog: false,\n      currentModel: {\n        name: '',\n        ai_provider: '',\n        model_type: 'llm',\n        k_tokens_cxjcoins: null,\n        settings: {\n          temperature: 1,\n          vector_size: 1536,\n          chunk_size: 8190,\n        },\n      },\n      modelToDelete: null,\n      showModelInfo: null\n    }\n  },\n  computed: {\n    aiModels() {\n      return this.settings.ai_models\n    },\n    aiProviders() {\n      return this.settings.ai_providers\n    }\n  },\n  methods: {\n    editModel(model) {\n      if (!model) {\n        model = { settings: {}, k_tokens_cxjcoins: null }\n        this.aiModels.push(model)\n      }\n      this.currentModel = model\n      this.showDialog = true\n    },\n    saveModel() {\n      this.showDialog = false\n    },\n    confirmDelete(model) {\n      this.showDialog = false\n      this.modelToDelete = model\n      this.showDeleteDialog = true\n    },\n    deleteModel() {\n      const index = this.aiModels.findIndex(m => m.name === this.modelToDelete.name)\n      if (index !== -1) {\n        this.aiModels.splice(index, 1)\n      }\n      this.showDeleteDialog = false\n    },\n    async reloadModel(model) {\n      model.loading = true\n      try {\n        const info = await this.$storex.api.projects.ai.models.reload(model)\n        model.metadata = { ...model.metadata || {}, info }\n        this.showModelInfo = model\n      } finally {\n        model.loading = false\n      }\n    }\n  }\n}\n</script>\n```",
