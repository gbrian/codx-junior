# =============================================================================
# Magnitude docker test harness - copy this file and adjust:
#
#     cp .env.example .env
# =============================================================================

# --- build -------------------------------------------------------------------
# CPU architecture of the machine you build on:
#   x86_64  -> x64     (default)
#   aarch64 -> arm64
MAGNITUDE_ARCH=x64

# --- server ------------------------------------------------------------------
# Port published on the host for the Magnitude server / web UI (container: 10100)
MAGNITUDE_PORT=10100

# Local API key used by the network API. Any long random string works;
# the `mag_` prefix follows the upstream convention.
MAGNITUDE_API_KEY=mag_local_dev_key

# --- model test --------------------------------------------------------------
# Leave MAGNITUDE_MODEL empty to auto-pick the first recommendation.
# Set it to a catalog id (e.g. from `magnitude catalog list`) to force a model.
MAGNITUDE_MODEL=

# fastest | faster | balanced | smarter | smartest
MAGNITUDE_PREFERENCE=fastest

# How many recommendations to print before choosing.
MAGNITUDE_RECO_LIMIT=5

MAGNITUDE_PROMPT=In one sentence, what is an inference engine?
MAGNITUDE_MAX_TOKENS=128
